{
  "name": "RGCxrClient",
  "version": "1.0.3",
  "summary": "A short description of RGCxrClient.",
  "homepage": "https://www.rokid.com/",
  "license": {
    "type": "Copyright",
    "text": " Copyright 2025 Rokid "
  },
  "authors": "Rokid R&D",
  "source": {
    "git": "https://github.com/rokid",
    "tag": "1.0.3"
  },
  "source_files": [
    "RGCxrClient/Classes/**/*",
    "RGCxrCore/Classes/**/*.{h,mm,c,m,cpp,swift}"
  ],
  "project_header_files": "RGCxrCore/Classes/**/*.h",
  "public_header_files": "RGCxrClient-Umbrella.h",
  "resources": "RGCxrClient/Assets/**/*",
  "vendored_libraries": "RGCxrCore/Vendors/libopus.a",
  "pod_target_xcconfig": {
    "BUILD_LIBRARY_FOR_DISTRIBUTION": "YES",
    "DEFINES_MODULE": "YES",
    "CLANG_ENABLE_MODULES": "YES",
    "SWIFT_COMPILATION_MODE": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL": "-Owholemodule",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++17",
    "CLANG_CXX_LIBRARY": "libc++",
    "GCC_PREPROCESSOR_DEFINITIONS": "$(inherited) CXR_PLATFORM_APPLE=1",
    "MODULEMAP_FILE": "$(PODS_TARGET_SRCROOT)/RGCxrClient/Module/module.modulemap",
    "SWIFT_INCLUDE_PATHS": "$(PODS_TARGET_SRCROOT)/RGCxrClient/Module",
    "APPLICATION_EXTENSION_API_ONLY": "NO",
    "ENABLE_BITCODE": "NO",
    "ONLY_ACTIVE_ARCH": "NO",
    "OTHER_LDFLAGS": "-lopus"
  },
  "user_target_xcconfig": {
    "CLANG_ENABLE_MODULES": "YES"
  },
  "preserve_paths": [
    "RGCxrClient/Module/module.modulemap",
    "Framework.xcconfig",
    "RGCxrClient-Umbrella.h"
  ],
  "swift_versions": "5.0",
  "platforms": {
    "ios": "13.0"
  },
  "frameworks": [
    "Foundation",
    "CoreBluetooth"
  ],
  "libraries": "c++",
  "dependencies": {
    "RGCoreKit": []
  },
  "swift_version": "5.0"
}
